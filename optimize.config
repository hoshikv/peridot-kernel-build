# --- Lighter & faster build: drop debug/dwarf/BTF bloat (KMI & vermagic unchanged) ---
CONFIG_DEBUG_INFO=n
CONFIG_DEBUG_INFO_DWARF4=n
CONFIG_DEBUG_INFO_BTF=n
CONFIG_DEBUG_INFO_NONE=y
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=n
CONFIG_DEBUG_INFO_COMPRESSED=n
CONFIG_GDB_SCRIPTS=n
# Keep vendor hooks & tracing intact (needed by hybridswap/OPlus)
CONFIG_ANDROID_VENDOR_HOOKS=y
